// actor
Table players {
  player_id int [pk, increment, note: 'actor']
  username varchar(64) [not null, unique, note: 'display name']
}

// producer
Table matches {
  match_id int [pk, increment, note: 'producer']
  is_active boolean [not null, note: 'activity flag']
}

// event
Table match_participants {
  match_id int [not null, note: 'FK to producer']
  player_id int [not null, note: 'FK to actor']
  played_at timestamp [not null, note: 'when the player joined or completed the match']
  score int [not null, note: 'metric to aggregate']

  indexes {
    (match_id, player_id) [pk]
  }
}

// catalog
Table game_modes {
  mode_id int [pk, increment, note: 'catalog']
  name varchar(64) [not null, unique]
}

// junction
Table match_modes {
  match_id int [not null, note: 'FK to producer']
  mode_id int [not null, note: 'FK to catalog']

  indexes {
    (match_id, mode_id) [pk]
  }
}

// ON DELETE behavior
Ref: match_participants.player_id > players.player_id [delete: restrict]
Ref: match_participants.match_id > matches.match_id [delete: cascade]
Ref: match_modes.match_id > matches.match_id [delete: cascade]
Ref: match_modes.mode_id > game_modes.mode_id [delete: restrict]
